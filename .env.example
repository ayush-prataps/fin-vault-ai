APP_NAME=FinVault AI
ENV=development
LOG_LEVEL=INFO

# Primary LLM Provider (OpenAI-compatible)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash

# Fallback LLM Provider (enabled for chatbot; strictly disabled in benchmark/eval)
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=qwen/qwen3.8-27b

LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_TOKENS=1024
GLOBAL_DAILY_CAP=500

# Evaluation Judge Configuration (used exclusively by eval judge)
JUDGE_BASE_URL=https://api.deepseek.com
JUDGE_API_KEY=
JUDGE_MODEL=deepseek-flash
DATABASE_URL=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
